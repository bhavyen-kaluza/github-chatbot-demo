# Copy to .env:  cp .env.example .env
#
# GitHub App credentials. Same values the Phase 1 probe used.
# GitHub > Settings > Developer settings > GitHub Apps > your app.
GITHUB_CLIENT_ID='Iv23li...'
GITHUB_CLIENT_SECRET='...'

# Anthropic API key for the chatbot.
ANTHROPIC_API_KEY='sk-ant-...'

# Optional. Defaults shown.
# ANTHROPIC_MODEL='claude-opus-5'
# ANTHROPIC_BASE_URL='https://your-gateway.example.com'   # only if your key goes through a gateway
# CLAUDE_FALLBACKS='on'        # 'off' disables the server-side refusal fallback
# GITHUB_REDIRECT_URI='http://localhost:3000/api/github/oauth/callback'   # must match the app settings exactly
